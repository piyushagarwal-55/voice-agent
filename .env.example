# Copy to .env and fill in. Never commit .env — it is gitignored.
# Single root .env — every app (web/api/agent/db) loads this same file via dotenv-cli.

# ---- LiveKit Cloud (free project at https://cloud.livekit.io) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same URL, exposed to the browser bundle — LiveKit room URLs are not secret.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- Groq (https://console.groq.com/keys) — LLM ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ---- Sarvam (https://dashboard.sarvam.ai) — STT + TTS ----
SARVAM_API_KEY=
SARVAM_LANGUAGE=hi-IN
SARVAM_MODE=translit
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_LANGUAGE=hi-IN

# ---- Supabase Postgres (https://supabase.com) ----
# Use the Supabase Session Pooler connection string for the running apps.
# Include `sslmode=require`; replace the password placeholder with your database password.
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Use Supabase's direct connection here for Prisma migrations (port 5432).
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres?sslmode=require

# ---- Hosted Redis (Upstash or Redis Cloud; Docker is not required) ----
# Use the Redis connection string supplied by your provider. It may start with `rediss://`.
REDIS_URL=redis://localhost:6379

# ---- apps/api ----
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Deliberately no NODE_ENV here — each tool (next build/dev, tsx) sets its own default,
# and forcing one value across all of them via this shared file breaks `next build`
# (it expects NODE_ENV=production during the build, not whatever dev default we'd pick).
